# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# C extensions
*.so

# Distribution / packaging
.Python
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.cache
nosetests.xml
coverage.xml

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# Video-Output
*.ts
*.mkv
*.mp4

# editor backups
*~
*.swp

# override-configs
/voctocore/config.ini
/voctogui/config.ini
/example-scripts/config.sh
/example-scripts/voctomidi/config.ini

# IDE project files
/*.iml
/.idea

# --- LaTeX compiled output (paper/) ---
/*.aux
/*.bbl
/*.blg
/*.fdb_latexmk
/*.fls
/*.lof
/*.log
/*.lot
/*.out
/*.synctex.gz
/*.synctex(busy)
/*.toc

# --- Runtime telemetry output ---
registros/
sessions/

# --- Video assets (too large for git, add manually) ---
videos/

# --- Backup files ---
*.bak
*.bak2
*.bak3
*\ (copia).*
*\ (otra\ copia).*

# --- Kubernetes secrets (never commit real credentials) ---
k8s/secret.yaml

# --- Environment variables (may contain credentials) ---
.env

voctocore/default-config.ini.orig
